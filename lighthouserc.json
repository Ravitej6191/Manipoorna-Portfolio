{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "numberOfRuns": 1
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.85
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*404\\.html).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    }
  }
}
